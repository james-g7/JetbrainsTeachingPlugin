<!-- Plugin Configuration File. Read more: https://plugins.jetbrains.com/docs/intellij/plugin-configuration-file.html -->
<idea-plugin>
    <id>com.github.jamesg7.hacktheburghxiii</id>
    <name>hacktheburghxiii</name>
    <vendor>james-g7</vendor>
    <description><![CDATA[
        <p><b>hacktheburghxiii</b> is a repository that provides a pure template to make it easier to create a new plugin project.</p>
        <p>The main goal of this template is to speed up the setup phase of plugin development for both new and experienced developers by preconfiguring the project scaffold and CI, linking to the proper documentation pages, and keeping everything organized.</p>
    ]]></description>

    <depends>com.intellij.modules.platform</depends>

    <resource-bundle>messages.MyBundle</resource-bundle>

    <extensions defaultExtensionNs="com.intellij">
        <toolWindow factoryClass="com.github.jamesg7.hacktheburghxiii.toolWindow.MyToolWindowFactory" id="MyToolWindow"/>
        <postStartupActivity implementation="com.github.jamesg7.hacktheburghxiii.startup.MyProjectActivity" />
    </extensions>

    <actions>
        <action id="myplugin.Highlight"
                class="actions.HighlightAction"
                text="Highlight"
                description="Highlight a range of code">
            <add-to-group group-id="ToolsMenu" anchor="last"/>
        </action>
        <action id="myplugin.ExplainHighlight"
                class="actions.ExplainHighlightAction"
                text="Highlight with Explanation"
                description="Highlight a range of code and show an explanation above it">
            <add-to-group group-id="ToolsMenu" anchor="last"/>
        </action>
        <action id="myplugin.ShowExplanation"
                class="actions.ShowExplanationAction"
                text="Show Explanation Tree"
                description="Load an explanation tree from JSON and show its root">
            <add-to-group group-id="ToolsMenu" anchor="last"/>
        </action>
        <action id="myplugin.ClearExplanations"
                class="actions.ClearExplanationsAction"
                text="Clear Explanations"
                description="Remove all explanation highlights and boxes">
            <add-to-group group-id="ToolsMenu" anchor="last"/>
        </action>
        <action id="myplugin.WalkThroughFunction"
                class="actions.WalkThroughFunctionAction"
                text="Walk Through Function…"
                description="Ask the AI for a step-by-step walkthrough of the function at the caret">
            <add-to-group group-id="ToolsMenu" anchor="last"/>
            <add-to-group group-id="EditorPopupMenu" anchor="last"/>
        </action>
        <action id="myplugin.ShowWalkthrough"
                class="actions.ShowWalkthroughAction"
                text="Show Walkthrough"
                description="Play a walkthrough from a JSON file">
            <add-to-group group-id="ToolsMenu" anchor="last"/>
        </action>
    </actions>

</idea-plugin>
